# Copy to .env.local (or .env.staging / .env.production) and adjust.
# Every value has a working default in src/config/env.config.ts, so the
# suite runs against ShopSmart with no .env file at all -- these overrides
# are only needed to point at a different environment.

# Which entry in src/config/env.config.ts to use: local | staging | production
TEST_ENV=local

# Overrides the baseURL for the selected environment.
BASE_URL=http://localhost:4300
