    "generate:experiment": "tsc -p tsconfig.json && node dist-ts/scripts/generate-experiment.js",
    "generate:stable-cohort": "tsc -p tsconfig.json && node dist-ts/scripts/generate-stable-cohort.js",
    "verify": "npm run verify:spc && npm run verify:gates && npm run verify:experiment && npm run verify:stable-cohort"
  },
